---
interface Props {
	eyebrow: string;
	title: string;
	as?: 'h1' | 'h2';
}

const { eyebrow, title, as: Heading = 'h2' } = Astro.props;
---

<div class="mb-10 flex flex-col items-center gap-3 text-center">
	<Heading class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</Heading>
	<p class="eyebrow eyebrow-tag">{eyebrow}</p>
	<slot />
</div>
