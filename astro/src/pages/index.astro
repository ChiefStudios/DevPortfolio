---
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Posts from '../components/Posts.astro';
import Layout from '../layouts/Layout.astro';
import { CLIENTS, WEEKLY_USERS, countWord } from '../data/clients';

const site = 'https://chiefosei.dev';
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Chief-Daniel Osei',
		url: site,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Chief-Daniel Osei',
		url: site,
		image: `${site}/og-image.png`,
		description: `Builds and runs the infrastructure behind websites serving thousands: ${countWord(CLIENTS.length)} client sites with ${WEEKLY_USERS} weekly users, with CI/CD, self-hosting and monitoring.`,
		address: { '@type': 'PostalAddress', addressLocality: 'Duisburg', addressCountry: 'DE' },
		sameAs: ['https://www.linkedin.com/in/chief-daniel', 'https://github.com/CD-Chief'],
	},
];
---

<Layout header={false} jsonLd={jsonLd}>
	<Hero />
	<Projects />
	<Posts />
</Layout>
