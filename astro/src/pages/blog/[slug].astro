---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TagList from '../../components/TagList.astro';
import { slugify } from '../../utils/slug';
import { formatDate, isPublished } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => isPublished(data.publishedAt));

  return posts.map((post) => ({
    params: { slug: post.data.slug ?? slugify(post.data.title) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('posts', ({ data }) => isPublished(data.publishedAt));
const allProjects = await getCollection('projects');

const relatedPostSlugs = post.data.relatedPosts ?? [];
const relatedPosts = relatedPostSlugs
  .map((slug) => allPosts.find((p) => (p.data.slug ?? slugify(p.data.title)) === slug))
  .filter((relatedPost): relatedPost is (typeof allPosts)[number] => Boolean(relatedPost));

// Link previews use the post's own cover, cropped to the 1200x630 size LinkedIn and others expect.
// SVG covers are drawn for a light backing that previews don't give them, so those keep the default card.
const ogCover =
  post.data.coverImage.format === 'svg'
    ? undefined
    : await getImage({ src: post.data.coverImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = ogCover ? { src: ogCover.src, width: 1200, height: 630, alt: post.data.title } : undefined;

const postUrl = new URL(`/blog/${post.data.slug ?? slugify(post.data.title)}`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.publishedAt,
  image: new URL(ogCover?.src ?? post.data.coverImage.src, Astro.site).href,
  mainEntityOfPage: postUrl,
  author: { '@type': 'Person', name: 'Chief-Daniel Osei', url: Astro.site?.href },
};

const relatedProjectIds = post.data.relatedProjects ?? [];
const relatedProjects = allProjects.filter((project) => relatedProjectIds.includes(project.data.id));
---

<Layout
  title={`${post.data.title} | Chief-Daniel Osei`}
  description={post.data.excerpt}
  type="article"
  jsonLd={jsonLd}
  image={ogImage}
  article={{ publishedTime: post.data.publishedAt, tags: [post.data.topic, ...post.data.tech] }}
>
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-4 sm:px-8">
    <nav class="flex flex-wrap gap-3" aria-label="Back">
      <a href="/" class="btn btn-ghost btn-sm">← Home</a>
      <a href="/blog" class="btn btn-ghost btn-sm">All posts</a>
    </nav>

    <header class="mb-8 mt-8 flex flex-col items-center gap-4 text-center">
      <h1 class="text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">{post.data.title}</h1>
      <p class="eyebrow eyebrow-tag flex items-center gap-2">
        <span>{post.data.topic}</span>
        <span class="text-ink-muted" aria-hidden="true">·</span>
        <time datetime={post.data.publishedAt} class="text-ink-muted">{formatDate(post.data.publishedAt)}</time>
      </p>
      <p class="text-lg leading-relaxed text-ink-muted">{post.data.excerpt}</p>
      <TagList tags={post.data.tech} class="justify-center" />
    </header>

    <div class:list={['mb-10 overflow-hidden rounded-2xl border border-line', post.data.coverImage.format === 'svg' && 'cover-svg p-6']}>
      <Image
        src={post.data.coverImage}
        alt=""
        width={post.data.coverImage.width}
        height={post.data.coverImage.height}
        sizes="(max-width: 768px) 100vw, 768px"
        class="h-auto w-full object-contain"
      />
    </div>

    <div class="prose prose-lg prose-invert prose-site max-w-none">
      <Content />
    </div>

    {post.data.links && post.data.links.length > 0 && (
      <section class="mt-14">
        <h2 class="eyebrow eyebrow-tag mb-4 text-center">Links</h2>
        <div class="flex flex-wrap justify-center gap-3">
          {post.data.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">
              {link.label} ↗
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="mt-14">
        <h2 class="eyebrow eyebrow-tag mb-4 text-center">Related posts</h2>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {relatedPosts.map((related) => (
            <li>
              <a
                href={`/blog/${related.data.slug ?? slugify(related.data.title)}`}
                class="card card-hover group flex flex-col gap-1 p-4"
              >
                <span class="font-semibold text-ink transition-colors group-hover:text-accent">{related.data.title}</span>
                <span class="font-Mono text-xs text-ink-muted">{formatDate(related.data.publishedAt)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedProjects.length > 0 && (
      <section class="mt-14">
        <h2 class="eyebrow eyebrow-tag mb-4 text-center">Related projects</h2>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {relatedProjects.map((project) => (
            <li>
              <a href="/projects" class="card card-hover group flex flex-col gap-1 p-4">
                <span class="font-semibold text-ink transition-colors group-hover:text-accent">{project.data.title}</span>
                <span class="font-Mono text-xs text-ink-muted">View on projects page</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>
